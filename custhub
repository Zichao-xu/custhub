#!/bin/bash
# custhub — 中枢上的唯一管理入口(root 跑)。Mac 经 ssh 受限账号调用, 参数全部按白名单校验。
#   info                      输出 name/host/net/wg_port/http_port/srvpub/ssh_port/sshkey/version(net/wg_port/srvpub 是旧版字段, 只为池兼容保留)
#   upgrade REF SHA           按指定版本(git commit + bootstrap.sh 的 sha256)从 GitHub/镜像拉代码后台重装, 效果同在服务器上粘一键命令
#   self-uninstall yes        后台卸载本机中枢(通知池子下线后清干净)
#   pool                      中枢池名单 TSV: name host wg_port http_port srvpub net joined seen left
#   drop N                    清旧版 WG 授权残留(WG 已停用, 兼容老清单)
#   job-put TOKEN             stdin = tar(TOKEN.ps1 TOKEN.m.ps1 TOKEN.sh), 放到下发目录
#   job-rm TOKEN              删下发脚本和回报
#   report TOKEN FROM         回报日志第 FROM 行起
#   done TOKEN | fail TOKEN   完成回报 / 失败日志尾
#   pkg-sums                  已有安装包的 sha256  相对路径
#   pkg-put                   stdin = tar, 解到安装包目录
# 反向隧道(客户机用 custtun 账号 ssh -R 挂回拨口 127.0.0.1:22000+N, N = Mac 上的全局别名号 c-N):
#   tun-set N KEYB64          登记/更新客户 N 的 ssh 公钥(base64 的 "ssh-ed25519 AAAA...")
#   tun-del N                 撤销客户 N
#   tun-list                  N  回拨口  是否在线(1/0)  来源公网地址(不在线为 -)
#   tun-sync                  按 tun/ 重写 custtun 的 authorized_keys
#   kick N                    踢掉占着客户 N 回拨口的旧连接(客户机断线重连前自己调; 只踢 custtun 的进程)
# 网络节点(把客户机当代理出口, 给指纹浏览器等用; 客户机自己用独立密钥 ssh -R 挂 127.0.0.1:23000+N, 本机公网端口转进去):
#   node-set N PORT KEYB64 [PORT2]  开/改客户 N 的节点: 公网 TCP PORT → 127.0.0.1:23000+N(socks5/http);
#                             可选 PORT2 → 127.0.0.1:24000+N(加密入口 shadowsocks); KEYB64 = 客户机节点通道公钥
#   node-del N                关客户 N 的节点(撤公钥、关端口)
#   node-relay N PORT KEYB64 PORT2 PKG SHA   (stdin 一行: 账号 密码 加密方法 加密密钥) 开/改客户 N 的节点(中转模式):
#                             会合点上跑 sing-box(PKG = /pkg 下的 Linux 版, 按 SHA 校验后装到 /usr/local/lib/custhub/sing-box)
#                             公网 PORT = socks5/http(TCP+UDP), PORT2 = shadowsocks(TCP+UDP); 唯一出口 = 127.0.0.1:23000+N
#                             (客户机的 microsocks 经节点通道挂上来), UDP 用 UDP-over-TCP v2 带过去; 客户机不用装 sing-box。
#                             配置由这里按参数生成, 不收外来配置文件
#   node-list                 N  公网端口  通道是否在线(1/0)  公网端口是否在听(1/0)  端口2  通道2  在听2(没开端口2 则为 - - -)
#   kick-node N               踢掉占着客户 N 节点通道的旧连接(客户机节点守护重连前自己调)
# 进度回报的 SSH 备用通道(客户机开着代理、HTTP 回报被弄丢时用; 账号 custrep, 每次接入一把一次性钥匙, 只能写这一次的回报):
#   rep-open TOKEN KEYB64     登记本次接入的回报钥匙(池里每台中枢都登记, 客户机哪台能连用哪台)
#   rep-close TOKEN           撤销(job-rm 也会撤); 超过 3 小时的自动清掉
#   rep-in TOKEN log|fail     custrep 的强制命令调用: stdin 每行 "步骤<TAB>说明[<TAB>用户 机器名]" 追加到回报; fail = stdin 是失败日志尾
set -euo pipefail
umask 022
S=/var/lib/custhub; W=/srv/custhub; R=/var/lib/custhub-report
. "$S/settings"   # NET WG_PORT HTTP_PORT HOST NAME

die(){ echo "ERR $*" >&2; exit 1; }
num(){ [[ $1 =~ ^[0-9]{1,3}$ ]] && [ "$1" -ge 2 ] && [ "$1" -le 254 ] || die "bad number"; }
tok(){ [[ $1 =~ ^[0-9a-f]{16,64}$ ]] || die "bad token"; }
pub(){ [[ $1 =~ ^[A-Za-z0-9+/]{43}=$ ]] || die "bad key"; }
lock(){ exec 9>"$S/lock"; flock -w 20 9; }
tn(){ [[ $1 =~ ^[0-9]{1,3}$ ]] && [ "$1" -ge 2 ] && [ "$1" -le 999 ] || die "bad client number"; }
TUN_BASE=22000; TU=custtun; NODE_BASE=23000; NODE2_BASE=24000; RU=custrep; UW=custhub-www
PROXYD=$(ls /lib/systemd/systemd-socket-proxyd /usr/lib/systemd/systemd-socket-proxyd 2>/dev/null | head -1 || true)
# 杀掉 custtun 占着某端口的监听(只动 custtun 的进程)
kick_port(){
  local pid
  for pid in $(ss -Hltnp "sport = :$1" 2>/dev/null | grep -o 'pid=[0-9]*' | cut -d= -f2 | sort -u); do
    [ "$(ps -o user= -p "$pid" 2>/dev/null | tr -d ' ')" = "$TU" ] && kill "$pid" 2>/dev/null && echo "kicked $pid"
  done; true
}
# 节点公网端口的 iptables 放行(宿主机有 INPUT DROP 时才有意义, 没装 iptables 跳过)
node_ipt(){  # node_ipt add|del PORT [tcp|udp]
  command -v iptables >/dev/null 2>&1 || return 0
  local pr=${3:-tcp}
  if [ "$1" = del ]; then iptables -D INPUT -p "$pr" --dport "$2" -j ACCEPT 2>/dev/null || true
  else iptables -C INPUT -p "$pr" --dport "$2" -j ACCEPT 2>/dev/null || iptables -I INPUT 1 -p "$pr" --dport "$2" -j ACCEPT; fi
}
# 节点公网端口校验(N 自己原来用的不算占用)
node_ports_ok(){  # node_ports_ok N PORT PORT2 OLD OLD2
  local n=$1 q f
  [ "$2" != "$3" ] || die "two ports must differ"
  for q in $2 $3; do
    [[ $q =~ ^[0-9]{4,5}$ ]] && [ "$q" -ge 1025 ] && [ "$q" -le 65000 ] || die "bad port $q"
    case $q in "$WG_PORT"|"$HTTP_PORT"|22) die "port $q reserved" ;; esac
    [ "$q" -ge "$TUN_BASE" ] && [ "$q" -lt $((NODE2_BASE+1000)) ] && die "port $q in tunnel range"
    for f in "$S"/node/*; do [ -f "$f" ] && [ "${f##*/}" != "$n" ] && grep -qxE "port2?=$q" "$f" && die "port $q used by node ${f##*/}"; done
    if [ "$q" != "$4" ] && [ "$q" != "$5" ] && ss -Hltn "sport = :$q" | grep -q .; then die "port $q busy"; fi
  done
}
# 关掉客户 N 的节点进程(两种模式的单元名都是 custhub-node-N[-2].{socket,service})
node_units_off(){  # node_units_off N
  local x
  for x in "" "-2"; do
    systemctl disable -q --now "custhub-node-$1$x.socket" "custhub-node-$1$x.service" 2>/dev/null || true
    rm -f "/etc/systemd/system/custhub-node-$1$x.socket" "/etc/systemd/system/custhub-node-$1$x.service"
  done
}
NODE_SB=/usr/local/lib/custhub/sing-box; NODE_CFG=/var/lib/custhub/node-cfg
tun_sync(){
  local f n k tmp
  mkdir -p "$S/tun"; tmp=$(mktemp)
  for f in "$S"/tun/*; do
    [ -f "$f" ] || continue; n=${f##*/}; k=$(cat "$f")
    # 只许挂自己的回拨口; 唯一能跑的命令是踢自己的旧连接; 不能开终端, 出站被 nft 封死
    printf 'restrict,port-forwarding,permitlisten="127.0.0.1:%s",command="sudo -n /usr/local/sbin/custhub kick %s" %s c-%s\n' "$((TUN_BASE+n))" "$n" "$k" "$n" >>"$tmp"
  done
  # 节点通道: 独立密钥, 只许挂 127.0.0.1:23000+N, 唯一能跑的命令是踢自己的旧节点通道
  for f in "$S"/node/*; do
    [ -f "$f" ] || continue; n=${f##*/}; k=$(sed -n 's/^key=//p' "$f")
    [ -n "$k" ] || continue
    pl="permitlisten=\"127.0.0.1:$((NODE_BASE+n))\""
    grep -q '^port2=[0-9]' "$f" && pl="$pl,permitlisten=\"127.0.0.1:$((NODE2_BASE+n))\""
    printf 'restrict,port-forwarding,%s,command="sudo -n /usr/local/sbin/custhub kick-node %s" %s c-%s-node\n' "$pl" "$n" "$k" "$n" >>"$tmp"
  done
  install -m600 -o "$TU" -g "$TU" "$tmp" "/home/$TU/.ssh/authorized_keys"; rm -f "$tmp"
}

# 回报钥匙: rep/TOKEN 一行公钥, 生成 custrep 的 authorized_keys(强制命令只能写自己这次的回报, 不能转发、不能开终端)
rep_sync(){
  local f t tmp
  mkdir -p "$S/rep"; tmp=$(mktemp)
  find "$S/rep" -type f -mmin +180 -delete 2>/dev/null || true
  for f in "$S"/rep/*; do
    [ -f "$f" ] || continue; t=${f##*/}
    printf 'restrict,command="/usr/local/sbin/custrep-ssh %s" %s rep-%s\n' "$t" "$(cat "$f")" "$t" >>"$tmp"
  done
  id "$RU" >/dev/null 2>&1 && install -m600 -o "$RU" -g "$RU" "$tmp" "/home/$RU/.ssh/authorized_keys"
  rm -f "$tmp"
}

cmd=${1:-}; shift || true
case $cmd in
  info)
    printf 'name=%s\nhost=%s\nnet=%s\nwg_port=%s\nhttp_port=%s\nsrvpub=%s\nssh_port=%s\nsshkey=%s\n' "${NAME:-}" "${HOST:-}" "$NET" "$WG_PORT" "$HTTP_PORT" "$(cat "$S/server.pub")" \
      "$(sshd -T 2>/dev/null | awk '$1=="port" && !p{print $2; p=1}' || true)" "$(cut -d' ' -f1,2 /etc/ssh/ssh_host_ed25519_key.pub)"
    printf 'version=%s\n' "${VERSION:-}" ;;
  pool)
    POOL_DIR=/var/lib/custhub-pool python3 -I /usr/local/lib/custhub/pool.py list ;;
  drop)   # 旧版 WG 授权的收回: WG 已停用, 只清残留记录(Mac 端老清单行会调到)
    num "$1"; rm -f "$S/peers/$1" ;;
  job-put)
    tok "$1"; t=$(mktemp -d)
    tar -x -C "$t" -f - --no-same-owner
    for f in "$1.ps1" "$1.m.ps1" "$1.sh"; do [ -f "$t/$f" ] || die "missing $f"; install -m644 "$t/$f" "$W/j/$f"; done
    rm -rf "$t" ;;
  job-rm)
    tok "$1"; rm -f "$W/j/$1".ps1 "$W/j/$1".m.ps1 "$W/j/$1".sh "$R/$1".*
    if [ -f "$S/rep/$1" ]; then lock; rm -f "$S/rep/$1"; rep_sync; fi ;;
  rep-open)
    tok "$1"; k=$(printf '%s' "${2:-}" | base64 -d 2>/dev/null | tr -d '\r\n')
    [[ $k =~ ^ssh-ed25519\ [A-Za-z0-9+/]{68}$ ]] || die "bad ssh key"
    id "$RU" >/dev/null 2>&1 || die "no $RU account (old hub version)"
    lock; mkdir -p "$S/rep"; printf '%s\n' "$k" >"$S/rep/$1"; rep_sync; echo ok ;;
  rep-close)
    tok "$1"; lock; rm -f "$S/rep/$1"; rep_sync; rm -f "$R/$1".* ;;
  rep-in)
    tok "$1"; [ -f "$S/rep/$1" ] || die "no such job"
    case ${2:-} in
      log)
        # 和 HTTP 回报同一格式落盘: "时间 步骤 说明(URL 编码)"; done 另写 .done "用户 机器名"
        head -c 65536 | head -n 300 | python3 -Ic '
import sys,time,urllib.parse as u,re
r=sys.argv[1]; q=lambda x:u.quote(x,safe="")[:1500]
for line in sys.stdin:
    p=line.rstrip("\r\n").split("\t")
    s=re.sub(r"[^a-z0-9-]","",p[0])[:20]
    if not s: continue
    m=p[1] if len(p)>1 else ""
    open(r+".log","a").write("%d %s %s\n"%(time.time(),s,q(m)))
    if s=="done":
        uh=(p[2] if len(p)>2 else "").split(" ",1)+[""]
        open(r+".done","w").write("%s %s\n"%(q(uh[0]),q(uh[1])))
' "$R/$1" ;;
      fail) head -c 24576 >"$R/$1.fail" ;;
      *) die "bad mode" ;;
    esac
    chown "$UW:$UW" "$R/$1".* 2>/dev/null || true; echo ok ;;
  report)
    tok "$1"; [[ $2 =~ ^[0-9]+$ ]] || die "bad offset"
    tail -n +"$2" "$R/$1.log" 2>/dev/null || true ;;
  done|fail)
    tok "$1"; cat "$R/$1.$cmd" 2>/dev/null || true ;;
  pkg-sums)
    cd "$W/pkg" && find . -type f ! -name '.*' -print0 | xargs -0r sha256sum | sed 's| \./| |' ;;
  pkg-put)
    t=$(mktemp -d "$W/pkg/.in.XXXX")
    tar -x -C "$t" -f - --no-same-owner --no-overwrite-dir
    # 只认普通文件, 拒绝绝对路径/.. (tar 默认已去掉开头的 /)
    if find "$t" ! -type f ! -type d | grep -q .; then rm -rf "$t"; die "only regular files"; fi
    (cd "$t" && find . -type f -print0) | while IFS= read -r -d '' f; do
      case $f in *..*) continue ;; esac
      mkdir -p "$W/pkg/$(dirname "$f")"; mv -f "$t/$f" "$W/pkg/$f"; chmod 644 "$W/pkg/$f"
    done
    rm -rf "$t"; find "$W/pkg" -type d -exec chmod 755 {} + ;;
  tun-set)
    tn "$1"; k=$(printf '%s' "${2:-}" | base64 -d 2>/dev/null | tr -d '\r\n')
    [[ $k =~ ^ssh-ed25519\ [A-Za-z0-9+/]{68}$ ]] || die "bad ssh key"
    lock; mkdir -p "$S/tun"; printf '%s\n' "$k" >"$S/tun/$1"; tun_sync ;;
  tun-del)
    tn "$1"; lock; rm -f "$S/tun/$1"; tun_sync; "$0" kick "$1" >/dev/null 2>&1 || true ;;
  tun-sync)
    lock; tun_sync ;;
  tun-list)
    # 第 4 列 = 这条反向通道从哪个公网地址连进来的(持有回拨口的 sshd 进程自己那条连接的对端), 供 Mac 试直连; 不在线为 -
    ls=$(ss -Hltnp 2>/dev/null); es=$(ss -Htnp state established 2>/dev/null)
    for f in "$S"/tun/*; do
      [ -f "$f" ] || continue; n=${f##*/}; p=$((TUN_BASE+n)); up=0; peer=-
      # 注意 set -e + pipefail: 找不到(客户离线)时 grep 返回 1 会让整个命令中途退出, 后面的客户全丢 → 必须 || true
      pid=$(awk -v a="127.0.0.1:$p" '$4==a' <<<"$ls" | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2 || true)
      if [ -n "$pid" ]; then up=1
        peer=$(grep "pid=$pid," <<<"$es" | awk '$3 ~ /:22$/ {print $4; exit}' || true)
        peer=${peer%:*}; peer=${peer#[}; peer=${peer%]}; peer=${peer#::ffff:}; peer=${peer:--}
      fi
      printf '%s\t%s\t%s\t%s\n' "$n" "$p" "$up" "$peer"
    done ;;
  kick)
    tn "$1"; kick_port $((TUN_BASE+$1)) ;;
  kick-node)
    tn "$1"; kick_port $((NODE_BASE+$1)); kick_port $((NODE2_BASE+$1)) ;;
  node-set)
    tn "$1"; n=$1; p=${2:-}; p2=${4:-}
    k=$(printf '%s' "${3:-}" | base64 -d 2>/dev/null | tr -d '\r\n')
    [[ $k =~ ^ssh-ed25519\ [A-Za-z0-9+/]{68}$ ]] || die "bad ssh key"
    [ -n "$PROXYD" ] || die "no systemd-socket-proxyd"
    lock; mkdir -p "$S/node"
    old=$(sed -n 's/^port=//p' "$S/node/$n" 2>/dev/null || true); old2=$(sed -n 's/^port2=//p' "$S/node/$n" 2>/dev/null || true)
    [ "$p" != "$p2" ] || die "two ports must differ"
    for q in $p $p2; do
      [[ $q =~ ^[0-9]{4,5}$ ]] && [ "$q" -ge 1025 ] && [ "$q" -le 65000 ] || die "bad port $q"
      case $q in "$WG_PORT"|"$HTTP_PORT"|22) die "port $q reserved" ;; esac
      [ "$q" -ge "$TUN_BASE" ] && [ "$q" -lt $((NODE2_BASE+1000)) ] && die "port $q in tunnel range"
      for f in "$S"/node/*; do [ -f "$f" ] && [ "${f##*/}" != "$n" ] && grep -qxE "port2?=$q" "$f" && die "port $q used by node ${f##*/}"; done
      if [ "$q" != "$old" ] && [ "$q" != "$old2" ] && ss -Hltn "sport = :$q" | grep -q .; then die "port $q busy"; fi
    done
    if grep -qx 'mode=relay' "$S/node/$n" 2>/dev/null; then   # 从中转模式切回端口转发: 先停中转服务和 UDP 放行
      node_units_off "$n"; rm -f "$NODE_CFG/$n.json"; for q in $old $old2; do node_ipt del "$q"; node_ipt del "$q" udp; done; old=; old2=
    fi
    printf 'port=%s\nkey=%s\nport2=%s\n' "$p" "$k" "$p2" >"$S/node/$n"; tun_sync
    # 每个公网端口一对 systemd socket+proxyd: custhub-node-N(→23000+N), custhub-node-N-2(→24000+N)
    unit(){  # unit 后缀 公网端口 本机端口
      local u=custhub-node-$n$1
      printf '[Unit]\nDescription=custhub node c-%s public port\n[Socket]\nListenStream=%s\n[Install]\nWantedBy=sockets.target\n' "$n" "$2" >"/etc/systemd/system/$u.socket"
      printf '[Unit]\nDescription=custhub node c-%s -> 127.0.0.1:%s\nRequires=%s.socket\nAfter=%s.socket\n[Service]\nExecStart=%s 127.0.0.1:%s\nDynamicUser=yes\nPrivateTmp=yes\nNoNewPrivileges=yes\n' \
        "$n" "$3" "$u" "$u" "$PROXYD" "$3" >"/etc/systemd/system/$u.service"
    }
    unit_off(){ systemctl disable -q --now "custhub-node-$n$1.socket" "custhub-node-$n$1.service" 2>/dev/null || true; rm -f "/etc/systemd/system/custhub-node-$n$1".{socket,service}; }
    if [ -n "$old" ] && [ "$old" != "$p" ]; then node_ipt del "$old"; unit_off ""; fi
    if [ -n "$old2" ] && [ "$old2" != "$p2" ]; then node_ipt del "$old2"; unit_off "-2"; fi
    unit "" "$p" $((NODE_BASE+n)); [ -n "$p2" ] && unit "-2" "$p2" $((NODE2_BASE+n))
    systemctl daemon-reload
    node_ipt add "$p"; systemctl enable -q --now "custhub-node-$n.socket"
    if [ -n "$p2" ]; then node_ipt add "$p2"; systemctl enable -q --now "custhub-node-$n-2.socket"; fi
    echo "ok $p $p2" ;;
  node-relay)
    tn "$1"; n=$1; p=${2:-}; p2=${4:-}; pkg=${5:-}; sha=${6:-}
    k=$(printf '%s' "${3:-}" | base64 -d 2>/dev/null | tr -d '\r\n')
    [[ $k =~ ^ssh-ed25519\ [A-Za-z0-9+/]{68}$ ]] || die "bad ssh key"
    case "$(uname -m)" in x86_64) ar=amd64 ;; aarch64) ar=arm64 ;; *) die "unsupported arch $(uname -m)" ;; esac
    [[ $pkg =~ ^node/sing-box-[0-9.]+-linux-$ar-musl$ ]] || die "bad pkg $pkg (need linux-$ar)"
    [[ $sha =~ ^[0-9a-f]{64}$ ]] || die "bad sha"
    read -r u pw m sk || die "no params on stdin"
    [[ $u =~ ^[A-Za-z0-9_]{1,32}$ ]] && [[ $pw =~ ^[A-Za-z0-9]{8,64}$ ]] || die "bad user/pass"
    case $m in aes-128-gcm|aes-256-gcm|chacha20-ietf-poly1305|2022-blake3-aes-128-gcm|2022-blake3-aes-256-gcm) ;; *) die "bad method" ;; esac
    [[ $sk =~ ^[A-Za-z0-9+/=]{16,88}$ ]] || die "bad ss key"
    lock; mkdir -p "$S/node"; mkdir -m 700 -p "$NODE_CFG"
    old=$(sed -n 's/^port=//p' "$S/node/$n" 2>/dev/null || true); old2=$(sed -n 's/^port2=//p' "$S/node/$n" 2>/dev/null || true)
    node_ports_ok "$n" "$p" "$p2" "$old" "$old2"
    # sing-box: 已装且指纹对就不动; 否则从下发目录 /pkg 装(Mac 端 sync-pkg 先传上来)
    if [ ! -x "$NODE_SB" ] || [ "$(sha256sum "$NODE_SB" | cut -c1-64)" != "$sha" ]; then
      [ -f "$W/pkg/$pkg" ] || die "pkg $pkg not uploaded"
      [ "$(sha256sum "$W/pkg/$pkg" | cut -c1-64)" = "$sha" ] || die "pkg sha mismatch"
      install -m 755 "$W/pkg/$pkg" "$NODE_SB.new"; mv -f "$NODE_SB.new" "$NODE_SB"
    fi
    # 停掉原来的(端口转发模式的 socket 单元 / 不再用的旧端口放行), 再写新的
    node_units_off "$n"
    for q in $old $old2; do [ "$q" = "$p" ] || [ "$q" = "$p2" ] || { node_ipt del "$q"; node_ipt del "$q" udp; }; done
    printf 'port=%s\nkey=%s\nport2=%s\nmode=relay\n' "$p" "$k" "$p2" >"$S/node/$n"; tun_sync
    (umask 077; python3 -I - "$p" "$p2" "$((NODE_BASE+n))" "$u" "$pw" "$m" "$sk" >"$NODE_CFG/$n.json" <<'CFGPY'
import sys, json
p, p2, tp, u, pw, m, sk = sys.argv[1:]
print(json.dumps({
  "log": {"level": "warn"},
  "inbounds": [
    {"type": "mixed", "tag": "in", "listen": "0.0.0.0", "listen_port": int(p), "users": [{"username": u, "password": pw}]},
    {"type": "shadowsocks", "tag": "ss", "listen": "0.0.0.0", "listen_port": int(p2), "method": m, "password": sk}],
  "outbounds": [{"type": "socks", "tag": "node", "server": "127.0.0.1", "server_port": int(tp),
                 "username": u, "password": pw, "udp_over_tcp": {"enabled": True, "version": 2}}],
  "route": {"final": "node"}}, indent=1))
CFGPY
    )
    "$NODE_SB" check -c "$NODE_CFG/$n.json" >/dev/null 2>&1 || die "sing-box check failed"
    printf '[Unit]\nDescription=custhub node c-%s relay (sing-box)\nAfter=network-online.target\n[Service]\nExecStart=%s run -c ${CREDENTIALS_DIRECTORY}/cfg\nLoadCredential=cfg:%s/%s.json\nDynamicUser=yes\nPrivateTmp=yes\nNoNewPrivileges=yes\nRestart=always\nRestartSec=5\n[Install]\nWantedBy=multi-user.target\n' \
      "$n" "$NODE_SB" "$NODE_CFG" "$n" >"/etc/systemd/system/custhub-node-$n.service"
    systemctl daemon-reload; systemctl enable -q "custhub-node-$n.service"; systemctl restart "custhub-node-$n.service"
    for q in $p $p2; do node_ipt add "$q"; node_ipt add "$q" udp; done
    sleep 1
    systemctl is-active -q "custhub-node-$n.service" || die "relay service failed: $(journalctl -u "custhub-node-$n" -n 3 --no-pager -o cat 2>/dev/null | tr '\n' ' ')"
    echo "ok $p $p2 relay" ;;
  node-del)
    tn "$1"; n=$1; lock
    for x in "" "-2"; do
      systemctl disable -q --now "custhub-node-$n$x.socket" "custhub-node-$n$x.service" 2>/dev/null || true
      rm -f "/etc/systemd/system/custhub-node-$n$x.socket" "/etc/systemd/system/custhub-node-$n$x.service"
    done
    systemctl daemon-reload
    for q in $(sed -n 's/^port2\{0,1\}=//p' "$S/node/$n" 2>/dev/null); do node_ipt del "$q"; node_ipt del "$q" udp; done
    rm -f "$S/node/$n" "$NODE_CFG/$n.json"; tun_sync; kick_port $((NODE_BASE+n)) >/dev/null; kick_port $((NODE2_BASE+n)) >/dev/null
    echo ok ;;
  node-list)
    ls=$(ss -Hltn 2>/dev/null | awk '{print $4}')
    up(){ grep -qx "127.0.0.1:$1" <<<"$ls" && echo 1 || echo 0; }
    pub(){ grep -qE ":$1\$" <<<"$ls" && echo 1 || echo 0; }
    for f in "$S"/node/*; do
      [ -f "$f" ] || continue; n=${f##*/}; p=$(sed -n 's/^port=//p' "$f"); p2=$(sed -n 's/^port2=//p' "$f")
      b2=$((NODE2_BASE+n)); grep -qx 'mode=relay' "$f" && b2=$((NODE_BASE+n))   # 中转模式两个入口共用一条节点通道
      if [ -n "$p2" ]; then x=$(printf '%s\t%s\t%s' "$p2" "$(up "$b2")" "$(pub "$p2")"); else x=$(printf -- '-\t-\t-'); fi
      printf '%s\t%s\t%s\t%s\t%s\n' "$n" "$p" "$(up $((NODE_BASE+n)))" "$(pub "$p")" "$x"
    done ;;
  upgrade)
    [[ ${1:-} =~ ^[0-9a-f]{40}$ ]] && [[ ${2:-} =~ ^[0-9a-f]{64}$ ]] || die "bad version"
    [ -n "${REPO:-}" ] || die "本机没记仓库(老版本装的), 请在服务器上粘一次一键命令"
    # 入池令牌用本机已有的: 池密钥 + 管理公钥 + 池里其他中枢当种子
    k=$(cat /var/lib/custhub-pool/pool.key)
    a=$(sed -n 's/^.*command="[^"]*" //p' "/home/custhub/.ssh/authorized_keys" | head -1 | cut -d' ' -f1,2)
    seeds=$(POOL_DIR=/var/lib/custhub-pool python3 -I /usr/local/lib/custhub/pool.py list | awk -F'\t' -v me="${HOST:-}" '$9=="0" && $2!=me {printf "%s:%s ", $2, $4}')
    tok=$(python3 -Ic 'import sys,json,base64;k,a,*s=sys.argv[1:];print("CH1:"+base64.b64encode(json.dumps({"k":k,"a":a,"s":s},separators=(",",":")).encode()).decode())' "$k" "$a" $seeds)
    cat >"$S/upgrade.sh" <<EOF
#!/bin/bash
f=\$(mktemp)
for u in 'https://api.github.com/repos/$REPO/contents/bootstrap.sh?ref=$1' 'https://raw.githubusercontent.com/$REPO/$1/bootstrap.sh' 'https://cdn.jsdelivr.net/gh/$REPO@$1/bootstrap.sh' 'https://ghfast.top/https://raw.githubusercontent.com/$REPO/$1/bootstrap.sh'; do
  curl -fsSL -m20 -H 'Accept: application/vnd.github.raw' -o \$f "\$u" && echo "$2  \$f" | sha256sum -c --status && { bash \$f $1 '$tok'; exit \$?; }
done
echo "下载 bootstrap 失败"; exit 1
EOF
    chmod 700 "$S/upgrade.sh"
    # 脱离当前 ssh 会话跑(重装会重启服务)
    setsid nohup bash "$S/upgrade.sh" >"$S/upgrade.log" 2>&1 </dev/null &
    echo started ;;
  self-uninstall)
    [ "${1:-}" = yes ] || die "need: self-uninstall yes"
    # 脱离当前 ssh 会话跑: 卸载会结束 custhub 账号的所有进程(包括这条会话)
    setsid nohup bash -c 'sleep 2; /usr/local/lib/custhub/uninstall.sh -y' >/var/log/custhub-uninstall.log 2>&1 </dev/null &
    echo started ;;
  *) die "unknown command" ;;
esac
